# Copy this file to .env and adjust values for your local environment.
TASKLOOM_ENVIRONMENT=development
TASKLOOM_LOG_LEVEL=INFO
TASKLOOM_LOG_FORMAT=text
TASKLOOM_DEBUG=false
TASKLOOM_MAX_WORKERS=3

# LLM settings. Keep real credentials only in the ignored local .env file.
TASKLOOM_LLM_PROVIDER=openai_compatible
TASKLOOM_LLM_MODEL=
TASKLOOM_LLM_API_KEY=
TASKLOOM_LLM_BASE_URL=
TASKLOOM_LLM_TEMPERATURE=0
TASKLOOM_LLM_TIMEOUT_SECONDS=60
TASKLOOM_LLM_MAX_RETRIES=0
TASKLOOM_LLM_PLANNER_MAX_OUTPUT_TOKENS=4096
TASKLOOM_LLM_WORKER_MAX_OUTPUT_TOKENS=8192
TASKLOOM_LLM_STRUCTURED_OUTPUT_METHOD=function_calling
